## Interface: 120100
## Title: Ka0s Aura Master
## Notes: Build your own buff, debuff and weapon enchant displays for player, target, focus and pet, as bars, icons or lines of text.
## Author: add1kted2ka0s
## Version: 0.1.0
## IconTexture: Interface\AddOns\AuraMaster\media\logos\auramaster.logo.128.tga
## SavedVariables: AuraMasterDB, AuraMasterPerfDB
## OptionalDeps: Ace3, LibStub, CallbackHandler-1.0, LibSharedMedia-3.0, LibDataBroker-1.1, LibDBIcon-1.0
## DefaultState: enabled
## Category-enUS: Combat
## X-License: MIT
## X-Standard: https://github.com/tusharsaxena/WowAddonStandards
## X-Curse-Project-ID: 1698345

# Libraries (vendored in libs/ — load first)
#@no-lib-strip@
libs\LibStub\LibStub.lua
libs\CallbackHandler-1.0\CallbackHandler-1.0.xml
libs\AceAddon-3.0\AceAddon-3.0.xml
libs\AceEvent-3.0\AceEvent-3.0.xml
libs\AceTimer-3.0\AceTimer-3.0.xml
libs\AceConsole-3.0\AceConsole-3.0.xml
libs\AceDB-3.0\AceDB-3.0.xml
libs\AceGUI-3.0\AceGUI-3.0.xml
libs\AceConfig-3.0\AceConfig-3.0.xml
libs\AceDBOptions-3.0\AceDBOptions-3.0.xml
libs\LibDataBroker-1.1\LibDataBroker-1.1.lua
libs\LibDBIcon-1.0\LibDBIcon-1.0.lua
libs\LibKa0s\LibKa0s.xml
libs\LibSharedMedia-3.0\lib.xml
libs\AceGUI-3.0-SharedMediaWidgets\widget.xml
#@end-no-lib-strip@

# Locales (first after the libraries: this file bootstraps NS.L for everything below)
# LOAD-BEARING: bootstraps NS.L, which every file below reads at load.
locales\enUS.lua

# Core — dependency-correct order (layout-§1)
# LOAD-BEARING: publishes NS.name, NS.version and NS.PREFIX, which every seam below reads.
core\Namespace.lua
# Conventional: its shims are reached at call time.
core\Compat.lua
# LOAD-BEARING: before Constants, deliberately. Constants.FONT_MONO is resolved from the
# NS.MediaFont seam this file publishes, so a Constants that loaded first would take the fallback.
core\MediaSetup.lua
core\Constants.lua
# Conventional: session-only state (the debug flag, the active container, preview).
core\State.lua
# Conventional: the LibKa0s-Env seam; nothing is resolved at load.
core\EnvSetup.lua
# LOAD-BEARING: after Namespace (NS.PREFIX) and before everything that prints; publishes
# NS.LIBKA0S_MISSING, which every later degradation stub reads.
core\CoreSetup.lua
# LOAD-BEARING: publishes NS.bus and NS.MSG, read at load by settings/OptionsSetup.lua.
core\Bus.lua
# Conventional: NS.Pool, reached at render time.
core\PoolSetup.lua
# LOAD-BEARING: before core/PerfSetup.lua, which takes this instance as its `lifecycle`
# descriptor field; LibKa0s-Perf-1.0 raises at New without one.
core\LifecycleSetup.lua
# LOAD-BEARING: before core/AuraMaster.lua and every module taking NS.Perf as a load-time upvalue.
core\PerfSetup.lua
# Conventional: the secret-value gates, reached at call time.
core\Secrets.lua
# LOAD-BEARING: after Constants (the font), State (the flag) and CoreSetup (the printer), and before
# anything that calls NS.Debug.
core\DebugLogSetup.lua
# Conventional: the LibKa0s-Launcher-1.0 seam. Reads Constants at load; NS.db, the lock and the
# settings panel are all reached at Register or click time.
core\LauncherSetup.lua
# LOAD-BEARING: the AceAddon promotion; reclaims NS.Print from AceConsole's embed.
core\AuraMaster.lua
# Conventional: reached from OnInitialize, at call time.
core\Database.lua

# Defaults
# LOAD-BEARING: Categories before Profile — the container template's category states are built
# from the category lists.
defaults\Categories.lua
# Conventional: a generated lookup, read at add time by settings/GeneralSpells.lua.
defaults\CastToAura.lua
defaults\Profile.lua

# Modules
# Conventional: a lookup over defaults/CastToAura.lua, read at add time by the two add boxes.
modules\CastAura.lua
# Conventional: TimedSpells and FilterCompiler resolve their peers at call time.
modules\TimedSpells.lua
modules\FilterCompiler.lua
# LOAD-BEARING: TextTemplate before Style_Text, which takes NS.TextTemplate as a file-scope upvalue.
modules\TextTemplate.lua
# LOAD-BEARING: Style before Style_Bars, Style_Icons and Style_Text, which decorate NS.Style at file
# scope.
modules\Style.lua
modules\Style_Bars.lua
modules\Style_Icons.lua
modules\Style_Text.lua
# Conventional: the rest of the modules; peers resolved at call time.
modules\Anchors.lua
modules\Preview.lua
modules\FramePicker.lua
modules\BlizzardFrames.lua
modules\Container.lua
modules\ContainerManager.lua

# Settings (last — depend on everything else being initialized)
# LOAD-BEARING: the schema machinery every page registers rows into.
settings\Schema.lua
# Conventional: its handlers reach the schema and pages at call time.
settings\Slash.lua
# LOAD-BEARING: before every page file, which calls the composers at file load.
settings\OptionsSetup.lua
# Conventional: the page files, each registering its rows and page at load.
settings\About.lua
# LOAD-BEARING: GeneralSpells before General, which registers its rows after its own (so the
# Spell Categories and Dispel Colors tabs follow Display).
settings\GeneralSpells.lua
settings\General.lua
# LOAD-BEARING: Containers is a top-level page (N-1); its tree position, right after General
# and before its sub-pages, is fixed by this load position (N-2).
settings\Containers.lua
# Conventional: the page files, each registering its rows and page at load. Filters, Layout,
# Bars, Icons and Text are sub-pages of Containers (N-2, D6): their tree label carries
# NS.SubPageLabel's mark, and this load position -- after Containers, before Profiles -- is
# what fixes their place in the tree.
settings\Filters.lua
settings\Layout.lua
settings\Bars.lua
settings\Icons.lua
settings\Text.lua
settings\Profiles.lua
