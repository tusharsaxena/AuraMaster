package-as: AuraMaster

# Libraries are vendored in libs/ and committed to git — NOT fetched as externals.

enable-nolib-creation: no

ignore:
  - .luacheckrc
  - .pkgmeta         # dev-only: this file configures the packager; it is not part of the package
  - .gitignore
  - .gitattributes   # dev-only: the repo's line-ending policy (line-endings)
  - .claude          # dev-only: agent tooling; never loaded by the client
  - .superpowers     # dev-only: agent tooling; never loaded by the client
  - docs             # holds docs/audits/ and docs/reviews/ too — all dev-only
  - tests
  - tools            # dev-only: committed generators (tools/spell-research/), never loaded in game
  - _dev
  - "*.bak"
  # Developer documentation. README.md and LICENSE stay, because players read those.
  - CLAUDE.md
  - DEPENDENCIES.md
  # Only the .tga logo is loadable at runtime; WoW cannot read .png or .jpg at all. The master .png
  # and the .jpg render exist for the project page and for regenerating the .tga.
  - media/logos/*.png
  - media/logos/*.jpg
